{ config, lib, pkgs, ... }:
let
  # Файл с PSK для strongSwan
  ipsecSecretFile = pkgs.writeText "ipsec-psk.secrets" ''
    %any 93.125.121.153 : PSK "CL*Z%{3h2abh?eifZ7"
  '';
in
{
  services.strongswan.enable = true;
  services.strongswan.setup = {
    uniqueids = "no";
  };

  services.strongswan.connections = {
    myvpn = {
      auto = "add";
      keyexchange = "ikev1";
      type = "transport";
      left = "%defaultroute";
      leftsubnet = "";
      leftprotoport = "17/1701";
      right = "93.125.121.153";
      rightsubnet = "";
      rightprotoport = "17/1701";
      authby = "psk";
      ike = "aes256-sha256-modp2048";
      esp = "aes256-sha1";
      keyingtries = "%forever";
      dpdaction = "restart";
      dpddelay = "30s";
      dpdtimeout = "120s";
    };
  };

  # Передаём список путей к файлам секретов
  services.strongswan.secrets = [
    "${ipsecSecretFile}"
  ];

  # Чтобы убрать предупреждение /etc/strongswan.conf
  environment.etc."strongswan.conf".text = ''
    charon {
      load_modular = yes
    }
  '';

  services.xl2tpd.enable = true;

  environment.etc."xl2tpd/xl2tpd.conf".text = ''
    [global]
    listen-addr = 0.0.0.0
    port = 1701

    [lac myvpn]
    lns = 93.125.121.153
    pppoptfile = /etc/ppp/options.xl2tpd.mylac
    require-mschapv2 = yes
    refuse-eap = yes
  '';

  environment.etc."ppp/options.xl2tpd.mylac".text = ''
    noauth
    refuse-eap
    require-mschapv2
    user "a_suhovarov"
    password "P4AeG5FWYvDhEtR"
  '';
}
