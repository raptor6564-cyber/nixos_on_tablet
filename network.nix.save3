{ config, lib, pkgs, ... }:
{
  services.strongswan.enable = true;
  services.strongswan.setup = {
    uniqueids = "no";
  };

  services.strongswan.connections = {
    myvpn = {
      auto = "add";
      keyexchange = "ikev1";
      type = "transport";
      left = "%defaultroute";
      leftprotoport = "17/1701";
      # leftsubnet = "";               # транспортный режим – без подсетей
      leftsubnet = null;               # транспортный режим – без подсетей
      right = "93.125.121.153";
      rightprotoport = "17/1701";
      # rightsubnet = "";
      rightsubnet = null;
      authby = "psk";
      ike = "aes256-sha256-modp2048";   # фаза 1 уже работает
      esp = "aes128-sha256-modp2048";   # алгоритм фазы 2 с PFS
      pfs = "yes";                      # требовать PFS (DH group из esp)
      keyingtries = "%forever";
      dpdaction = "restart";
      dpddelay = "30s";
      dpdtimeout = "120s";
    };
  };

  # PSK отдельным файлом (путь в списке)
  services.strongswan.secrets = [
    "${pkgs.writeText "ipsec-psk.secrets" ''
      %any 93.125.121.153 : PSK "CL*Z%{3h2abh?eifZ7"
    ''}"
  ];

  # Детальное логирование в syslog (смотреть через journalctl)
  environment.etc."strongswan.conf".text = ''
    charon {
      load_modular = yes
      syslog {
        identifier = charon
        daemon {
          default = 2
          ike = 3
          cfg = 3
        }
      }
    }
  '';

  services.xl2tpd.enable = true;

  environment.etc."xl2tpd/xl2tpd.conf".text = ''
    [global]
    listen-addr = 0.0.0.0
    port = 1701

    [lac myvpn]
    lns = 93.125.121.153
    pppoptfile = /etc/ppp/options.xl2tpd.mylac
    require-mschapv2 = yes
    refuse-eap = yes
  '';

  environment.etc."ppp/options.xl2tpd.mylac".text = ''
    noauth
    refuse-eap
    require-mschapv2
    user "a_suhovarov"
    password "P4AeG5FWYvDhEtR"
  '';
}
